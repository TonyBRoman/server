<link rel="stylesheet" href="/css/styles.css">

<main>
    <h1>Welcome to CSE Motors</h1>

    <section class="hero-container">
        <div class="hero-image">
            <img src="/images/vehicles/delorean.jpg" alt="DMC Delorean">
            <div class="hero-text">
                <h2>DCM Delorean</h2>
                <ul>
                    <li>3 Cup holders</li>
                    <li>Superman doors</li>
                    <li>Fuzzy dice!</li>
                </ul>
                <button type="button" class="hero-btn">Own Today</button>
            </div>
        </div>
    </section>
 

    <section class="info-grid">
        <div class="upgrades">
            <h3>Delorean Upgrades</h3>
            <div class="upgrade-cards">
                <div class="card">
                    <div class="img-placeholder"><img src="/images/upgrades/flux-cap.png" alt="Flux Capacitor"></div>
                    <a href="#">Flux Capacitor</a>
                </div>
                <div class="card">
                    <div class="img-placeholder"><img src="/images/upgrades/flame.jpg" alt="Flame Decals"></div>
                    <a href="#">Flame Decals</a>
                </div>
                <div class="card">
                    <div class="img-placeholder"><img src="/images/upgrades/bumper_sticker.jpg" alt="Bumper Stickers"></div>
                    <a href="#">Bumper Stickers</a>
                </div>
                <div class="card">
                    <div class="img-placeholder"><img src="/images/upgrades/hub-cap.jpg" alt="Hub Caps"></div>
                    <a href="#">Hub Caps</a>
                </div>
            </div>
        </div>

        <div class="reviews">
            <h3>DMC Delorean Reviews</h3>
            <ul>
                <li>"So fast it's almost like traveling in time." (4/5)</li>
                <li>"Coolest ride on the road." (4/5)</li>
                <li>"I'm feeling McFly!" (5/5)</li>
                <li>"The most futuristic ride of our day." (4.5/5)</li>
                <li>"80's livin and I love it!" (5/5)</li>
            </ul>
        </div>
    </section>
</main>