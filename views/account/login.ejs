<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title><%= title %></title>
</head>
<body>
    <main>
        <h1 class="login-title"><%= title %></h1>
        <%- messages() %>

        <form class="login-form" action="/account/login" method="post">
            <div class="form-group floating-label">
                <input type="email" id="account_email" name="account_email" placeholder=" " required>
                <label for="account_email">Email</label>
            </div>

            <div class="form-group floating-label">
                <input type="password" id="account_password" name="account_password" placeholder=" " required>
                <label for="account_password">Password</label>
            </div>

            <button type="submit" class="btn-login">Login</button>
        </form>

        <p class="register-link">Not registered? <a href="/account/register">Register</a></p>
    </main>

    
</body>
</html>