<main class="account-update-view">
  <h1 class="title"><%= title %></h1> <%- messages() %>

  <% if (errors) { %>
    <ul class="flash-message error">
      <% errors.forEach(error => { %>
        <li><%= error.msg %></li>
      <% }) %>
    </ul>
  <% } %>

  <section class="update-section">
    <form action="/account/update" method="post" class="register-form">
      <h2>Update Account Information</h2>
      
      <div class="form-group"> <label for="account_firstname">First Name</label>
        <input type="text" id="account_firstname" name="account_firstname" 
          required value="<%= locals.account_firstname ? locals.account_firstname : accountData.account_firstname %>">
      </div>

      <div class="form-group">
        <label for="account_lastname">Last Name</label>
        <input type="text" id="account_lastname" name="account_lastname" 
          required value="<%= locals.account_lastname ? locals.account_lastname : accountData.account_lastname %>">
      </div>

      <div class="form-group">
        <label for="account_email">Email Address</label>
        <input type="email" id="account_email" name="account_email" 
          required value="<%= locals.account_email ? locals.account_email : accountData.account_email %>">
      </div>

      <input type="hidden" name="account_id" value="<%= accountData.account_id %>">
      <br/>
      <button type="submit" class="btn-register">Update Info</button> </form>
  </section>

  <section class="update-section">
    <form action="/account/change-password" method="post" class="register-form">
      <h2>Change Password</h2>
      <p class="password-hint"> Entering a new password will change your current one. 
        Requirements: 12+ characters, 1 uppercase, 1 number, 1 special char.
      </p>
      
      <div class="form-group">
        <label for="account_password">New Password</label>
        <input type="password" id="account_password" name="account_password" 
          required pattern="^(?=.*[A-Z])(?=.*\d)(?=.*[@$!%*?&]).{12,}$">
      </div>

      <input type="hidden" name="account_id" value="<%= accountData.account_id %>">
      <br/>
      <button type="submit" class="btn-register">Change Password</button>
    </form>
  </section>
</main>