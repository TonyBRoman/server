<link rel="stylesheet" href="/css/styles.css">

<header id="top-header">
  <span class="siteName">
    <a href="/" title="Return to home Page">CSS Motors</a>
  </span>

  <div id="tools">
    <% if (locals.loggedin) { %> <a href="/account/" title="Go to account management">
        Welcome <%= locals.accountData.account_firstname %>
      </a>
      <a class="dash-item-logout" href="/account/logout" title="Click to log out">Logout</a>
    <% } else { %>
      <a href="/account/login" title="Click to log in">My Account</a>
    <% } %>
  </div>
</header>